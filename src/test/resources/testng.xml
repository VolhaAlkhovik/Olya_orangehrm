<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="LoginSuite" verbose="1" thread-count="3" parallel="methods">
    <listeners>
        <listener class-name="listeners.SuiteXMLTransformer"/>
        <listener class-name="listeners.ScreenshotListener"/>
    </listeners>
    <parameter name="username"  value="Admin"/>
    <parameter name="password"  value="admin123"/>
    <test name="Login">
        <classes>
            <class name = "LoginSuccess"/>
            <class name = "AddEmployeeTest"/>
        </classes>
    </test>
</suite>
